# Vexer Enterprise Intelligence Platform — Domain 6
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime artifacts (recreated automatically)
vexer_agent_checkpoints.db
vexer_agent_checkpoints.db-shm
vexer_agent_checkpoints.db-wal

# Secrets — never commit real API keys
.env

# Local Alembic overrides (a developer may point at a local database here; it must never be
# committed because it can contain a DSN with a password). migrations/env.py reads the DSN from
# VEXER_POSTGRES_DSN, not from alembic.ini, so nothing needs to be stored here at all.
alembic.local.ini

# Editor / agent tooling metadata — machine-local, never part of the product
.codely-cli/

# Smoke-test scratch (smoke_test.ps1 writes its logs to %TEMP%, not here)
smoke_run.log
